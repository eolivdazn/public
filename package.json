{
  "name": "travel-dashboard-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "build:dashboard": "vite build",
    "build:quick-expense-widget": "vite build --config vite.quick-expense.config.mjs",
    "build": "npm run build:site && npm run build:dashboard && npm run build:quick-expense-widget",
    "dev:dashboard": "vite",
    "preview:dashboard": "vite preview",
    "test": "node --test scripts/travel-data.test.mjs dashboard/src/lib/*.test.js",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "exifr": "^7.1.3",
    "gray-matter": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^27.4.0",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  }
}
