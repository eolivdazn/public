{
  "routes": [
    {
      "route": "/og/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/share/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["approved"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/github"
    }
  }
}
