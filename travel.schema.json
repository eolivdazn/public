{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/travel.schema.json",
  "title": "Travel Dashboard Frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "title",
    "slug",
    "schema",
    "tripType",
    "startDate",
    "endDate",
    "year",
    "dateCounting",
    "places"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Canonical trip identifier: lowercase letters, digits and hyphens. Used as the output HTML filename and as tripSlug in the expenses API."
    },
    "schema": {
      "type": "string",
      "const": "travel-dashboard/v1"
    },
    "tripType": {
      "type": "string",
      "const": "vacation"
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "endDate": {
      "type": "string",
      "format": "date"
    },
    "year": {
      "type": "integer",
      "description": "The trip's primary year. Must fall within startDate's and endDate's year."
    },
    "dateCounting": {
      "type": "string",
      "const": "inclusive"
    },
    "expenses": {
      "type": "object",
      "additionalProperties": true,
      "required": ["baseCurrency", "categories"],
      "properties": {
        "baseCurrency": {
          "type": "string",
          "minLength": 1
        },
        "partySize": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flights": {
              "type": "number",
              "minimum": 0
            },
            "hotel": {
              "type": "number",
              "minimum": 0
            },
            "food": {
              "type": "number",
              "minimum": 0
            },
            "entertainment": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": ["flights", "hotel", "food", "entertainment"]
        }
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["city", "country", "startDate", "endDate"],
        "properties": {
          "city": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}

